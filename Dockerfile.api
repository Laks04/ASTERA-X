FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*
COPY services/api/requirements-runtime.txt ./requirements-runtime.txt
RUN python -m pip install --upgrade pip && pip install -r requirements-runtime.txt
COPY services/api/ ./
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && python scripts/seed_registry.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
