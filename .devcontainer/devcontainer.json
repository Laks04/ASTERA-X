{
  "name": "ASTERA Development Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [3000, 8000, 5432, 6379],
  "portsAttributes": {
    "3000": { "label": "ASTERA Web", "onAutoForward": "openBrowser" },
    "8000": { "label": "ASTERA API" }
  },
  "postCreateCommand": "python -m pip install --upgrade pip",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  }
}
